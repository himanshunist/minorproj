# Copy to backend/.env for local development.
# Comma-separated origins allowed by CORS. Set to your Vercel domain in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
MAX_BATCH_ROWS=5000
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
# Optional override if artifacts live elsewhere:
# MODEL_DIR=/absolute/path/to/backend/models
