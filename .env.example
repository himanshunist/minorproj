# ---------- Backend (Render/uvicorn) ----------
APP_NAME=Intrusion Detection System API
APP_VERSION=1.0.0
# Comma-separated origins. Add your Vercel domain after deployment.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
MAX_BATCH_ROWS=5000
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
# MODEL_DIR=/absolute/path/to/backend/models

# ---------- Frontend (Vite) ----------
# No VITE_ variables are secrets; they are embedded in the browser bundle.
VITE_API_URL=http://localhost:8000
